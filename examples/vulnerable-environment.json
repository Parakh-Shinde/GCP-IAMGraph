      "bindings": [
        {"role": "roles/owner", "members": ["serviceAccount:deployment@payments-prod.iam.gserviceaccount.com"]},
        {"role": "roles/resourcemanager.projectIamAdmin", "members": ["user:iam-operator@example.test"]},
        {"role": "roles/iam.serviceAccountKeyAdmin", "members": ["user:contractor@example.test"]},
        {"role": "roles/storage.objectViewer", "members": ["allUsers"]}
